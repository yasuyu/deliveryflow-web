DATABASE_URL="file:./delivery.db"
DATABASE_PROVIDER=sqlite
PORT=3000
OFFER_TTL_SECONDS=30
OFFER_CANDIDATE_LIMIT=3
# Optional: allow a managed DB to sleep; expired locations are deleted on next authenticated use.
DATABASE_IDLE_MODE=false
# Optional: server-side OpenAI API (usage billed separately). Free template feedback works without a key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# SCORE_BONUS_SIMULATED_NOW="2026-09-14T22:00:00+09:00"
