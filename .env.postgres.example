POSTGRES_DB=deliveryflow
POSTGRES_USER=deliveryflow
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_HOST_PORT=5433
APP_PORT=3106
OFFER_TTL_SECONDS=30
OFFER_CANDIDATE_LIMIT=3
# Optional: allow a managed DB to sleep; expired locations are deleted on next authenticated use.
DATABASE_IDLE_MODE=false
# Optional: Gemini, only after verifying this key's project has no billing account (Free Tier).
# This confirmation does not check Google billing automatically. Keep false when uncertain.
GEMINI_API_KEY=
GEMINI_FREE_TIER_CONFIRMED=false
