{
  "name": "rideflow-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file=.env server.js",
    "dev:postgres": "docker compose --env-file .env.postgres up --watch",
    "studio:postgres": "node scripts/studio-postgresql.js",
    "check": "node --check server.js && node --check public/app.js && node --check scripts/studio-postgresql.js",
    "test": "node --test",
    "load-test": "node scripts/load.js",
    "test:postgresql-smoke": "node scripts/postgresql-smoke.js",
    "db:generate": "node --env-file=.env node_modules/prisma/build/index.js generate",
    "db:migrate": "node --env-file=.env node_modules/prisma/build/index.js migrate dev",
    "db:studio": "node --env-file=.env node_modules/prisma/build/index.js studio"
  },
  "dependencies": {
    "@prisma/client": "^6.19.1"
  },
  "devDependencies": {
    "prisma": "^6.19.1"
  },
  "allowScripts": {
    "prisma@6.19.1": true,
    "@prisma/client@6.19.1": true,
    "@prisma/engines@6.19.1": true
  }
}
